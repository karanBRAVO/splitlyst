# Database
DATABASE_URL="postgresql://username:password@localhost:5432/splitlyst"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-here"

# Optional: Exchange Rate API (get free key at https://exchangerate-api.com)
EXCHANGE_RATE_API_KEY="your_api_key_here"

# Optional: File uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# App URL (for PWA & links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email — verification, password reset, reminders and expense notifications.
# Without any provider, links are only shown in local development.
#
# Option A (free, no domain needed): Gmail SMTP with an *app password*
#   (Google Account -> Security -> 2-Step Verification on -> App passwords)
SMTP_USER=""
SMTP_PASS=""
# SMTP_HOST="smtp.gmail.com"   # default
# SMTP_PORT="465"              # default (465 = TLS, 587 = STARTTLS)
#
# Option B: Resend (https://resend.com) — requires a domain you have verified there
RESEND_API_KEY=""
#
# Sender. For Gmail it must be the account's own address (defaults to "Splitlyst <SMTP_USER>").
EMAIL_FROM=""
# Force one provider when both are set: smtp | resend (default: SMTP if configured, else Resend)
# EMAIL_PROVIDER=""

# Secret for the recurring-expense cron job (Vercel sends it as a Bearer token).
CRON_SECRET="generate-a-long-random-string"

# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@yourdomain.com"

# Optional: "Continue with Google" (https://console.cloud.google.com/apis/credentials)
# Redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
